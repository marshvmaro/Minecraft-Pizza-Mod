		"main": [
			"name.pizza.PizzaMod"
		],
		"fabric-datagen": [
			"name.pizza.PizzaModDataGenerator"
		]
	},
	"mixins": [
		"pizza-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"

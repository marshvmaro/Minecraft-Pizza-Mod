{
	"schemaVersion": 1,
	"id": "pizza-mod",
	"version": "${version}",
	"name": "Pizza Mod",
	"description": "This is a mod for adding pizza to Minecraft",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT-License",
	"icon": "assets/pizza-mod/icon.png",
	"environment": "*",
